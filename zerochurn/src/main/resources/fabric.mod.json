{
  "schemaVersion": 1,
  "id": "zerochurn",
  "version": "${version}",
  "name": "ZeroChurn",
  "description": "Reduces GC hitching by interning and pooling short-lived BlockPos, Vec3, and AABB allocations on a per-thread basis, designed to work alongside Lithium, Sodium, and other Fabric performance mods.",
  "authors": [
    "ZeroChurn"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.zerochurn.ZeroChurnMod"
    ],
    "client": [
      "dev.zerochurn.client.ZeroChurnClient"
    ]
  },
  "mixins": [
    "zerochurn.mixins.json",
    {
      "config": "zerochurn.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "infoforge": "*",
    "lithium": "*",
    "sodium": "*",
    "immediatelyfast": "*",
    "ferritecore": "*",
    "modernfix": "*"
  }
}
